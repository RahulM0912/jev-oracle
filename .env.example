# Copy to .env.local and fill in. Never commit .env.local.
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# typesafe = real Jev (costs credits), mock = fake answers (free, no key needed)
JEV_PROVIDER=mock

# Optional: pin a model version (default jev-latest)
# JEV_MODEL=jev-latest

# Optional: key for encrypting Jev's Secret game tokens. If unset, one is derived from TYPESAFE_API_KEY.
# GAME_SECRET=
